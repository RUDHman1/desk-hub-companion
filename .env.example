# Desk Hub Companion - Environment Configuration
# If Supabase keys are provided, the app connects directly to live PostgreSQL with RLS.
# If omitted or left as placeholder, the app seamlessly activates its high-fidelity mock engine
# with pre-seeded cohorts, allowing instant local testing without remote dependencies.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
